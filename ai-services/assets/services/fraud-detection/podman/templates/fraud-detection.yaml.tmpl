apiVersion: v1
kind: Pod
metadata:
  name: "fraud-detection-{{ .InstanceSlug }}"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    ai-services.io/routes: "9000:fraud-detection-{{ .InstanceSlug }}:api"
spec:
  restartPolicy: always
  volumes:
    - name: model-cache
      emptyDir: {}
  initContainers:
    - name: model-downloader
      image: "{{ .Values.api.image }}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          set -e
          export AWS_ACCESS_KEY_ID="{{ .Values.s3AccessKeyId }}"
          export AWS_SECRET_ACCESS_KEY="{{ .Values.s3SecretAccessKey }}"
          echo "Downloading model from s3://{{ .Values.s3Bucket }}/{{ .Values.s3Key }}"
          aws s3 cp \
            --endpoint-url "{{ .Values.s3Endpoint }}" \
            --recursive \
            "s3://{{ .Values.s3Bucket }}/{{ .Values.s3Key }}" \
            /model-cache/
          echo "Model ready at /model-cache/"
      volumeMounts:
        - mountPath: /model-cache
          name: model-cache
  containers:
    - name: triton
      image: "{{ .Values.triton.image }}"
      command: ["tritonserver"]
      args:
        - "--model-repository=/model-cache"
        - "--strict-model-config=false"
      livenessProbe:
        httpGet:
          path: /v2/health/live
          port: 8000
        initialDelaySeconds: 30
        periodSeconds: 15
        timeoutSeconds: 5
        failureThreshold: 4
      readinessProbe:
        httpGet:
          path: /v2/health/ready
          port: 8000
        initialDelaySeconds: 15
        periodSeconds: 10
        timeoutSeconds: 5
        failureThreshold: 6
      resources:
        requests:
          memory: "8Gi"
        limits:
          memory: "8Gi"
      ports:
        - containerPort: 8000
        - containerPort: 8001
        - containerPort: 8002
      volumeMounts:
        - mountPath: /model-cache:z
          name: model-cache
          readOnly: true
    - name: fraud-detection-api
      image: "{{ .Values.api.image }}"
      command: ["/bin/sh", "-c"]
      args:
        - |
          exec /opt/app-root/bin/python3 -m uvicorn app:app \
            --host 0.0.0.0 \
            --port 9000 \
            --loop uvloop \
            --http httptools
      env:
        - name: TRITON_HTTP_URL
          value: "http://localhost:8000"
        - name: TRITON_MODEL_NAME
          value: "{{ .Values.triton.modelName }}"
        - name: REVIEW_THRESHOLD
          value: "{{ .Values.api.reviewThreshold }}"
        - name: DECLINE_THRESHOLD
          value: "{{ .Values.api.declineThreshold }}"
        - name: LOG_LEVEL
          value: "{{ .Values.api.log_level }}"
      ports:
        - containerPort: 9000
          protocol: TCP
      livenessProbe:
        httpGet:
          path: /health
          port: 9000
        initialDelaySeconds: 10
        periodSeconds: 30
        timeoutSeconds: 5
        failureThreshold: 3
      resources:
        requests:
          memory: "1536Mi"
        limits:
          memory: "1536Mi"
